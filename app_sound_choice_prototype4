def run_cv_activity():
    cap = cv2.VideoCapture(1)
    time.sleep(1.0)

    if not cap.isOpened():
        print("Error: Could not open camera. Trying index 0...")
        cap = cv2.VideoCapture(0)
        if not cap.isOpened(): return
        
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
    
    SMOOTHING_FACTOR = 8 
    ALPHA = 0.2  

    ARUCO_DICT = aruco.getPredefinedDictionary(aruco.DICT_4X4_50)
    PARAMS = aruco.DetectorParameters()
    mpHands = mp.solutions.hands
    hands = mpHands.Hands(max_num_hands=MAX_HANDS, min_detection_confidence=0.7)
    mpDraw = mp.solutions.drawing_utils 

    MAP_CONFIG = {
        11: {
            'image': cv2.imread("craved_map/craved_map1.jpeg"), 
            'masks': {
                'blue': cv2.imread("craved_map/masks/blue_mask.png", 0),
                'green': cv2.imread("craved_map/masks/green_mask.png", 0),
                'red': cv2.imread("craved_map/masks/red_mask.png", 0),
                'beige': cv2.imread("craved_map/masks/beige_mask.png", 0),
                'blue_caption': cv2.imread("craved_map/masks/blue_caption.png", 0),
                'green_caption': cv2.imread("craved_map/masks/green_caption.png", 0),
                'red_caption': cv2.imread("craved_map/masks/red_caption.png", 0),
                'beige_caption': cv2.imread("craved_map/masks/beige_caption.png", 0),
            }
        },
        9: {
            'image': cv2.imread("craved_map2/Frame 7_id9.png"), 
            'masks': {
                'blue': cv2.imread("craved_map2/masks/blue_mask.png", 0),
                'green': cv2.imread("craved_map2/masks/green_mask.png", 0),
                'red': cv2.imread("craved_map2/masks/red_mask.png", 0),
                'beige': cv2.imread("craved_map2/masks/beige_mask.png", 0),
                'blue_caption': cv2.imread("craved_map2/masks/blue_caption.png", 0),
                'green_caption': cv2.imread("craved_map2/masks/green_caption.png", 0),
                'red_caption': cv2.imread("craved_map2/masks/red_caption.png", 0),
                'beige_caption': cv2.imread("craved_map2/masks/beige_caption.png", 0),
            }
        },
        3: {
            'image': cv2.imread("craved_map3/Frame 8_id8.png"), 
            'masks': {
                'blue': cv2.imread("craved_map3/masks/blue_mask.png", 0),
                'green': cv2.imread("craved_map3/masks/green_mask.png", 0),
                'red': cv2.imread("craved_map3/masks/red_mask.png", 0),
                'beige': cv2.imread("craved_map3/masks/beige_mask.png", 0),
                'blue_caption': cv2.imread("craved_map3/masks/blue_caption.png", 0),
                'green_caption': cv2.imread("craved_map3/masks/green_caption.png", 0),
                'red_caption': cv2.imread("craved_map3/masks/red_caption.png", 0),
                'beige_caption': cv2.imread("craved_map3/masks/beige_caption.png", 0),
            }
        },
        4: {'image': cv2.imread("map_6x4/map_6x4.jpeg"), 'masks': {k: cv2.imread(f"map_6x4/masks/{k}_mask.png", 0) for k in ['blue', 'green', 'red', 'beige']}},
        20: {'image': cv2.imread("map_coop_id20/map_coop_id20.png"), 'masks': {k: cv2.imread(f"map_coop_id20/masks/{k}_mask.png", 0) for k in ['blue', 'green', 'red', 'beige']}},
        24: {'image': cv2.imread("map_leslie/Frame17_qrcode_outside.png"), 'masks': {k: cv2.imread(f"map_leslie/masks/{k}_mask.png", 0) for k in ['blue', 'green', 'red', 'beige']}}
    }

    calib_pts = np.array([[0, 0], [100, 0], [100, 100], [0, 100]], dtype=np.float32)
    selected_corner = 0
    calibration_mode = False
    lock_homography = False
    
    map_image = None
    masks = None
    map_h = map_w = 0
    averaged_h_matrix = None
    last_marker_id = None
    hand_states = {0: {'last_color': None, 'channel': HAND_CHANNELS[0], 'pos_history': []}}

    print("\n--- CV CONTROLS ---")
    print("[L] Lock & Print Coords | [R] Refresh Homography")
    print("[C] Calibration Mode | [1-4] Select Corner | [WASD/Arrows] Move")
    print("[ESC] Exit\n")

    last_animal_status = {}
    last_animal_position = {}
    last_animal_coords = {}

    while True:
        ret, frame = cap.read()
        if not ret:
            cv2.waitKey(10)
            continue
        
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        corners, ids, _ = aruco.detectMarkers(gray, ARUCO_DICT, parameters=PARAMS)

        if ids is not None:
            for corner in corners:
                cv2.cornerSubPix(gray, corner, winSize=(5, 5), zeroZone=(-1, -1), 
                                 criteria=(cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 30, 0.1))

        if ids is not None and not lock_homography:
            for i, m_id in enumerate(ids.flatten()):
                if m_id in MAP_CONFIG:
                    if last_marker_id != m_id:
                        map_image = MAP_CONFIG[m_id]['image']
                        masks = MAP_CONFIG[m_id]['masks']
                        map_h, map_w, _ = map_image.shape
                        last_marker_id = m_id
                        
                        if not calibration_mode:
                            if m_id in [3, 9, 11]:
                                size = 490 if m_id != 11 else 277
                                calib_pts = np.array([[map_w-size, 0], [map_w, 0], [map_w, size], [map_w-size, size]], dtype=np.float32)
                            elif m_id in [4, 21]:
                                calib_pts = np.array([[map_w-344, 30], [map_w-42, 30], [map_w-42, 338], [map_w-344, 338]], dtype=np.float32)
                            elif m_id in [20, 22, 27]:
                                calib_pts = np.array([[map_w-535, 580], [map_w-182, 580], [map_w-182, 934], [map_w-535, 934]], dtype=np.float32)
                            elif m_id in [24]:
                                calib_pts = np.array([[map_w-173, 11], [map_w-15, 11], [map_w-15, 173], [map_w-173, 173]], dtype=np.float32)


                    h_curr, _ = cv2.findHomography(corners[i][0], calib_pts)

                    if h_curr is not None:
                        if averaged_h_matrix is None:
                            averaged_h_matrix = h_curr
                        else:
                            averaged_h_matrix = cv2.addWeighted(averaged_h_matrix, (1.0 - ALPHA), h_curr, ALPHA, 0)
                    
                    cv2.polylines(frame, [corners[i][0].astype(int)], True, (0, 255, 0), 2)
                    break

        key = cv2.waitKey(1) & 0xFF
        if key == 27: break
        elif key == ord('l'):
            lock_homography = not lock_homography
            print(f"\n[COORDINATES] ID {last_marker_id}: {calib_pts.tolist()}")
        elif key == ord('r'):
            averaged_h_matrix = None
            print("[RESET] History cleared.")
        elif key == ord('c'):
            calibration_mode = not calibration_mode

        if calibration_mode:
            if key in [ord('1'), ord('2'), ord('3'), ord('4')]:
                selected_corner = int(chr(key)) - 1
            if key == 82 or key == ord('w'): calib_pts[selected_corner][1] -= 2 # Moved slightly faster for ease
            if key == 84 or key == ord('s'): calib_pts[selected_corner][1] += 2
            if key == 81 or key == ord('a'): calib_pts[selected_corner][0] -= 2
            if key == 83 or key == ord('d'): calib_pts[selected_corner][0] += 2

        # DRAW BLUE MAP BOUNDARY ON CAMERA VIEW
        if averaged_h_matrix is not None and map_image is not None:
            try:
                # The boundary represents the outer edge of your digital map image [0,0] to [w,h]
                map_outline = np.float32([[0, 0], [map_w, 0], [map_w, map_h], [0, map_h]]).reshape(-1, 1, 2)
                # Invert the homography to project map coordinates back onto the camera frame
                h_inv = cv2.invert(averaged_h_matrix)[1]
                cam_outline = cv2.perspectiveTransform(map_outline, h_inv)
                cv2.polylines(frame, [np.int32(cam_outline)], True, (255, 0, 0), 3) # BLUE DELIMITATION
            except: 
                pass

        map_display = map_image.copy() if map_image is not None else np.zeros((480, 854, 3), dtype=np.uint8)

        if calibration_mode:
            for idx, pt in enumerate(calib_pts):
                color = (0, 255, 0) if idx == selected_corner else (0, 0, 255)
                size = 12 if idx == selected_corner else 6
                cv2.circle(map_display, (int(pt[0]), int(pt[1])), size, color, -1)
            cv2.putText(frame, "CALIBRATION ACTIVE", (50, 50), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)

        # --- POINTER LOGIC (ARUCO 2 OR INDEX FINGER) ---
        pointer_map_pt = None
        pointer_active = False

        # 1. Check for ArUco 2 first
        if ids is not None and averaged_h_matrix is not None:
            flattened_ids = ids.flatten()
            if 2 in flattened_ids:
                idx2 = np.where(flattened_ids == 2)[0][0]
                c2 = corners[idx2][0]
                # Center of the marker
                cx2, cy2 = int(c2[:, 0].mean()), int(c2[:, 1].mean())
                
                pt_in = np.array([[[cx2, cy2]]], dtype=np.float32)
                pointer_map_pt = cv2.perspectiveTransform(pt_in, averaged_h_matrix)[0][0]
                pointer_active = True
                # Visual feedback on camera frame
                cv2.circle(frame, (cx2, cy2), 10, (0, 255, 255), -1) 

        # 2. Fallback to MediaPipe if ArUco 2 is not detected
        if not pointer_active:
            results = hands.process(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
            if results.multi_hand_landmarks and averaged_h_matrix is not None:
                hand_lms = results.multi_hand_landmarks[0]
                mpDraw.draw_landmarks(frame, hand_lms, mpHands.HAND_CONNECTIONS)
                tip = hand_lms.landmark[mpHands.HandLandmark.INDEX_FINGER_TIP]
                cx, cy = int(tip.x * frame.shape[1]), int(tip.y * frame.shape[0])
                
                pt_in = np.array([[[cx, cy]]], dtype=np.float32)
                pointer_map_pt = cv2.perspectiveTransform(pt_in, averaged_h_matrix)[0][0]
                pointer_active = True

        # 3. Process the resulting coordinate for sounds
        if pointer_active and pointer_map_pt is not None:
            hand_states[0]['pos_history'].append((pointer_map_pt[0], pointer_map_pt[1]))
            if len(hand_states[0]['pos_history']) > SMOOTHING_FACTOR: 
                hand_states[0]['pos_history'].pop(0)
            
            avg_mx, avg_my = np.mean(hand_states[0]['pos_history'], axis=0).astype(int)
            
            # Draw pointer on map display (Yellow if ArUco, Magenta if Finger)
            pointer_color = (0, 255, 255) if pointer_active and (ids is not None and 2 in ids.flatten()) else (255, 0, 255)
            cv2.circle(map_display, (avg_mx, avg_my), 40, pointer_color, -1) 

            detected = None
            if masks and 0 <= avg_my < map_h and 0 <= avg_mx < map_w:
                for key_m, mask_m in masks.items():
                    if mask_m[avg_my, avg_mx] > 0:
                        detected = key_m; break

            if detected != hand_states[0]['last_color']:
                hand_states[0]['channel'].stop()
                if detected in FINAL_SOUNDS:
                    # If it's a caption, play once. If it's a habitat, loop it.
                    is_looping = -1 if "caption" not in detected else 0
                    hand_states[0]['channel'].play(FINAL_SOUNDS[detected], loops=is_looping)
                hand_states[0]['last_color'] = detected
        else:
            # Nothing detected, stop sound
            hand_states[0]['channel'].stop()
            hand_states[0]['last_color'] = None

        # Animal detection
        MOVEMENT_THRESHOLD = 25 # Minimum pixels moved to re-trigger sound

        if ids is not None and averaged_h_matrix is not None and masks is not None: 
            for i, marker_id in enumerate(ids.flatten()):
                if marker_id in ANIMAL_HABITATS:
                    # 1. Map Coordinate Calculation
                    c = corners[i][0]
                    cx_animal, cy_animal = int(c[:,0].mean()), int(c[:,1].mean())
                    pt = np.array([[[cx_animal, cy_animal]]], dtype=np.float32)
                    map_pt = cv2.perspectiveTransform(pt, averaged_h_matrix)[0][0]
                    mx_animal, my_animal = int(map_pt[0]), int(map_pt[1])
                    
                    # 2. Check Habitat Region
                    current_region = None
                    if 0 <= my_animal < map_h and 0 <= mx_animal < map_w:
                        for mask_key, mask_img in masks.items():
                            if mask_img[my_animal, mx_animal] > 0:
                                current_region = mask_key
                                break

                    # 3. Sound & Movement Logic
                    if current_region:
                        is_correct = current_region in ANIMAL_HABITATS[marker_id]
                        status = "correct" if is_correct else "wrong"
                        
                        # Calculate distance from last recorded position
                        prev_coords = last_animal_coords.get(marker_id)
                        has_moved_significantly = False
                        
                        if prev_coords:
                            # Euclidean Distance: sqrt((x2-x1)^2 + (y2-y1)^2)
                            dist = np.linalg.norm(np.array([mx_animal, my_animal]) - np.array(prev_coords))
                            if dist > MOVEMENT_THRESHOLD:
                                has_moved_significantly = True

                        # Play sound if:
                        # A) Moved significantly OR B) Entered a brand new habitat
                        if has_moved_significantly or last_animal_position.get(marker_id) != current_region:
                            # Only play if the channel isn't already busy to avoid "stuttering"
                            if not ANIMAL_CHANNEL.get_busy(): 
                                ANIMAL_CHANNEL.play(FINAL_SOUNDS[status])
                            
                            # Update persistent state
                            last_animal_position[marker_id] = current_region
                            last_animal_coords[marker_id] = (mx_animal, my_animal)
                    else:
                        # If animal leaves all habitat zones, clear its history
                        last_animal_position.pop(marker_id, None)
                        last_animal_coords.pop(marker_id, None)

                    # 4. Visual Feedback for testing
                    color = (0, 255, 0) if current_region in ANIMAL_HABITATS[marker_id] else (0, 0, 255)
                    cv2.circle(map_display, (mx_animal, my_animal), 50, color, 2)


        if map_image is not None:
            f_h, f_w, _ = frame.shape
            scale = 720 / f_h
            resized_f = cv2.resize(frame, (int(f_w * scale), 720))
            resized_m = cv2.resize(map_display, (int(map_w * (720 / map_h)), 720))
            cv2.imshow("Activity Window", np.hstack((resized_f, resized_m)))
        else:
            cv2.imshow("Activity Window", cv2.resize(frame, (1280, 720)))

    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    run_selection_menu()
    log_selections(selected_indices)
    run_pause_menu()
    run_cv_activity()