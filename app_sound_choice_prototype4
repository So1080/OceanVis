LOG_DIR = "study_logs"

def log_selections(selected_indices):

    if not os.path.exists(LOG_DIR):
        os.makedirs(LOG_DIR)
        print(f"Created directory: {LOG_DIR}")
    
    date_str = datetime.now().strftime("%Y-%m-%d")
    # filename = f"selections_{date_str}.csv"
    filename = os.path.join(LOG_DIR, f"selections_{date_str}.csv")
    
    file_exists = os.path.isfile(filename)
    
    user_id = datetime.now().strftime("%H%M%S")
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    with open(filename, mode='a', newline='') as file:
        writer = csv.writer(file)
        
        # Write header if new file
        if not file_exists:
            writer.writerow(["Timestamp", "User_ID", "Sparse_Live_Bottom", "Dense_Live_Bottom", "Flat_Sand", "Rippled_Sand"])
        
        # Write the data row
        writer.writerow([
            timestamp,
            user_id,
            selected_indices["Sparse live bottom"],
            selected_indices["Dense live bottom"],
            selected_indices["Flat sand"],
            selected_indices["Rippled sand"]
        ])
    print(f"Data logged successfully to {filename}")

