    else:
        print(f"  [MISSING] {key}: {os.path.abspath(path)}")
print("----------------------------------\n")


# -------------------------------------------------------------------
# 3. HELPERS & MAP RENDERING
# -------------------------------------------------------------------
def detect_cube_color(crop_bgr):
    if crop_bgr is None or crop_bgr.size == 0:
        return "Unknown"
    hsv        = cv2.cvtColor(crop_bgr, cv2.COLOR_BGR2HSV)
    max_pixels = 0
    detected   = "Unknown"
    for name, (lower, upper) in COLOR_HSV_RANGES.items():
        mask  = cv2.inRange(hsv, lower, upper)
        count = cv2.countNonZero(mask)
        if count > max_pixels and count > (crop_bgr.shape[0] * crop_bgr.shape[1] * 0.15):
            max_pixels = count
            detected   = name
    return detected


def get_camera_stream():
    for idx in [1, 0, 2]:
        cap = cv2.VideoCapture(idx)
        if cap.isOpened():
            ret, frame = cap.read()
            if ret and frame is not None:
                print(f"Connected to camera index {idx}")
                return cap
            cap.release()
    return None


def get_finger_tips(results, frame_w, frame_h):
    tips = []
    if results.multi_hand_landmarks and results.multi_handedness:
        for lms, handedness in zip(results.multi_hand_landmarks, results.multi_handedness):
            if handedness.classification[0].score < HAND_CONFIDENCE_THRESHOLD:
                continue
            tip    = lms.landmark[mp.solutions.hands.HandLandmark.INDEX_FINGER_TIP]
            fx, fy = int(tip.x * frame_w), int(tip.y * frame_h)
            if 0 <= fx < frame_w and 0 <= fy < frame_h:
                tips.append((fx, fy))
    return tips


def draw_map_display(revealed_grid, active_cell, status_msg, status_color, width=800, height=800):
    """Generates the clean visitor-facing exhibit screen showing the pixelated seafloor map."""
    map_img = np.zeros((height, width, 3), dtype=np.uint8)
    
    # Title Header
    cv2.putText(map_img, "Sea Floor Habitat Map", (40, 50),
                cv2.FONT_HERSHEY_SIMPLEX, 1.1, (255, 255, 255), 2, cv2.LINE_AA)

    # Grid Placement Area
    start_x, start_y = 50, 80
    grid_size = min(width - 100, height - 200)
    cell_w = grid_size // GRID_COLS
    cell_h = grid_size // GRID_ROWS

    for r in range(GRID_ROWS):
        for c in range(GRID_COLS):
            x1 = start_x + c * cell_w
            y1 = start_y + r * cell_h
            x2 = x1 + cell_w
            y2 = y1 + cell_h

            habitat_type = TARGET_GRID_HABITATS[r][c]
            is_revealed  = revealed_grid[r][c]

            # Choose fill color
            if is_revealed:
                color = HABITAT_DISPLAY_COLORS.get(habitat_type, (200, 200, 200))
            else:
                color = HABITAT_DISPLAY_COLORS["Grey"]

            # Draw Pixel Cell
            cv2.rectangle(map_img, (x1, y1), (x2, y2), color, -1)
            
            # Highlight cell currently being touched
            if active_cell == (r, c):
                cv2.rectangle(map_img, (x1, y1), (x2, y2), (0, 255, 255), 6)
            else:
                cv2.rectangle(map_img, (x1, y1), (x2, y2), (30, 30, 30), 2)

            # Label revealed cells
            if is_revealed:
                cv2.putText(map_img, habitat_type, (x1 + 10, y1 + cell_h // 2),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 0), 2, cv2.LINE_AA)

    # Status Bar Footer
    footer_y = start_y + grid_size + 50
    cv2.putText(map_img, status_msg, (40, footer_y),
                cv2.FONT_HERSHEY_SIMPLEX, 0.8, status_color, 2, cv2.LINE_AA)

    # Check if map is 100% completed
    if all(all(row) for row in revealed_grid):
        cv2.putText(map_img, "SANCTUARY MAP FULLY REVEALED!", (40, footer_y + 40),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 0), 2, cv2.LINE_AA)

    return map_img


# -------------------------------------------------------------------
# 4. MAIN LOOP
# -------------------------------------------------------------------
def main():
    cap = get_camera_stream()
    if cap is None:
        print("Error: could not open camera.")
        return

    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  1280)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)

    aruco_dict   = aruco.getPredefinedDictionary(aruco.DICT_4X4_100)
    aruco_params = aruco.DetectorParameters()

    mp_hands_mod = mp.solutions.hands
    hands        = mp_hands_mod.Hands(
        max_num_hands=2,
        min_detection_confidence=0.7,
        min_tracking_confidence=0.7
    )
    mp_draw = mp.solutions.drawing_utils

    # Map State (False = Grey / Unrevealed, True = Color / Revealed)
    revealed_grid = [[False for _ in range(GRID_COLS)] for _ in range(GRID_ROWS)]

    # Interaction state
    hovered_cell      = None
    hover_start       = None

    playing_cell      = None
    saved_cell        = None
    saved_crop        = None

    finger_in_cell    = False
    absent_since      = None

    eval_pending      = False
    eval_trigger_time = None

    locked            = False

    status_msg   = "Touch and hold a cube to hear its habitat."
    status_color = (255, 255, 255)

    while cap.isOpened():
        ret, frame = cap.read()
        if not ret or frame is None:
            time.sleep(0.1)
            continue

        now     = time.time()
        h, w, _ = frame.shape

        # ---- ArUco ----
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        corners, ids, _ = aruco.detectMarkers(gray, aruco_dict, parameters=aruco_params)

        pt1, pt2 = None, None
        if ids is not None:
            aruco.drawDetectedMarkers(frame, corners, ids)
            for i, mid in enumerate(ids.flatten()):
                c = corners[i][0]
                if mid == 45:
                    pt1 = (int(c[:, 0].mean()), int(c[:, 1].mean()))
                elif mid == 57:
                    pt2 = (int(c[:, 0].mean()), int(c[:, 1].mean()))

        # ---- Hand tracking ----
        results = hands.process(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
        tips    = get_finger_tips(results, w, h)

        if results.multi_hand_landmarks and results.multi_handedness:
            for lms, handedness in zip(results.multi_hand_landmarks, results.multi_handedness):
                if handedness.classification[0].score >= HAND_CONFIDENCE_THRESHOLD:
                    mp_draw.draw_landmarks(frame, lms, mp_hands_mod.HAND_CONNECTIONS)

        for fx, fy in tips:
            cv2.circle(frame, (fx, fy), 8, (255, 0, 255), -1)

        # ---- Grid ----
        if pt1 and pt2:
            mx1, mx2 = min(pt1[0], pt2[0]), max(pt1[0], pt2[0])
            my1, my2 = min(pt1[1], pt2[1]), max(pt1[1], pt2[1])
            sx, sy   = mx2 - mx1, my2 - my1

            gx1 = int(mx1 + sx * GRID_OFFSET_X)
            gy1 = int(my1 + sy * GRID_OFFSET_Y)
            gx2 = int(mx2 - sx * GRID_OFFSET_X)
            gy2 = int(my2 - sy * GRID_OFFSET_Y)

            cv2.rectangle(frame, (gx1, gy1), (gx2, gy2), (255, 0, 0), 2)

            cw = (gx2 - gx1) / GRID_COLS
            ch = (gy2 - gy1) / GRID_ROWS

            current_cell  = None
            current_crop  = None
            current_fpos  = None

            for r in range(GRID_ROWS):
                for c in range(GRID_COLS):
                    cx1 = int(gx1 + c * cw);       cy1 = int(gy1 + r * ch)
                    cx2 = int(gx1 + (c+1) * cw);   cy2 = int(gy1 + (r+1) * ch)

                    ix1 = int(cx1 + (cx2-cx1)*0.2); iy1 = int(cy1 + (cy2-cy1)*0.2)
                    ix2 = int(cx1 + (cx2-cx1)*0.8); iy2 = int(cy1 + (cy2-cy1)*0.8)

                    cv2.rectangle(frame, (cx1, cy1), (cx2, cy2), (255, 255, 0), 1)

                    for fx, fy in tips:
                        if cx1 <= fx <= cx2 and cy1 <= fy <= cy2:
                            current_cell = (r, c)
                            current_crop = frame[iy1:iy2, ix1:ix2].copy()
                            current_fpos = (fx, fy)
                            cv2.rectangle(frame, (cx1, cy1), (cx2, cy2), (0, 255, 255), 2)

            # ==============================================================
            # STATE MACHINE
            # ==============================================================

            # PHASE 5: Locked while evaluation audio plays
            if locked:
                if not EVAL_CHANNEL.get_busy():
                    locked = False

            # PHASE 4: Evaluation
            elif eval_pending:
                if now - eval_trigger_time >= DEBOUNCE_DELAY:
                    eval_pending = False
                    locked       = True

                    r_e, c_e       = saved_cell
                    target         = TARGET_GRID_HABITATS[r_e][c_e]
                    detected       = detect_cube_color(saved_crop)

                    print(f"[EVAL] cell ({r_e},{c_e}) target={target} detected={detected}")

                    if detected == target:
                        status_msg   = f"Cube ({r_e+1},{c_e+1}) CORRECT: {target}"
                        status_color = (0, 255, 0)
                        
                        # REVEAL PIXEL ON MAP DISPLAY
                        revealed_grid[r_e][c_e] = True
                        
                        if "correct" in LOADED_SOUNDS:
                            EVAL_CHANNEL.play(LOADED_SOUNDS["correct"])
                    else:
                        status_msg   = f"Cube ({r_e+1},{c_e+1}) INCORRECT: Facing {detected}, expected {target}"
                        status_color = (0, 0, 255)
                        if "wrong" in LOADED_SOUNDS:
                            EVAL_CHANNEL.play(LOADED_SOUNDS["wrong"])

            # PHASE 3: Lift Detection
            elif playing_cell is not None:
                now_in_cell = (current_cell == playing_cell)

                if now_in_cell:
                    finger_in_cell = True
                    absent_since   = None
                else:
                    if finger_in_cell:
                        if absent_since is None:
                            absent_since = now
                    finger_in_cell = False

                    if absent_since is not None and (now - absent_since) >= LIFT_CONFIRM_TIME:
                        print(f"[LIFT CONFIRMED] cell {playing_cell}")
                        HABITAT_CHANNEL.stop()

                        saved_cell        = playing_cell
                        playing_cell      = None
                        finger_in_cell    = False
                        absent_since      = None
                        hovered_cell      = None
                        hover_start       = None

                        eval_pending      = True
                        eval_trigger_time = now

                        status_msg   = f"Evaluating Cube ({saved_cell[0]+1},{saved_cell[1]+1})..."
                        status_color = (200, 200, 200)

            # PHASE 1 & 2: Dwell & Play
            else:
                if current_cell != hovered_cell:
                    hovered_cell = current_cell
                    hover_start  = now if current_cell is not None else None

                if hovered_cell is not None and hover_start is not None:
                    dwell = now - hover_start

                    if current_fpos:
                        progress = min(1.0, dwell / DWELL_TIME)
                        cv2.circle(frame, current_fpos, int(8 + progress * 12), (0, 255, 255), 2)

                    if dwell >= DWELL_TIME:
                        playing_cell   = hovered_cell
                        saved_cell     = hovered_cell
                        saved_crop     = current_crop.copy() if current_crop is not None else None
                        finger_in_cell = True
                        absent_since   = None

                        r_h, c_h = playing_cell
                        habitat  = TARGET_GRID_HABITATS[r_h][c_h]
                        if habitat in LOADED_SOUNDS:
                            HABITAT_CHANNEL.play(LOADED_SOUNDS[habitat], loops=-1)

                        print(f"[PLAYING] cell ({r_h},{c_h}): {habitat}")
                        status_msg   = f"Listening to Cube ({r_h+1},{c_h+1}): {habitat}"
                        status_color = (0, 255, 255)

                        hovered_cell = None
                        hover_start  = None

        else:
            cv2.putText(frame, "Waiting for ArUco markers 45 and 57...",
                        (30, 90), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 165, 255), 2)

        # Draw Visitor Map Display Window
        active_cell = playing_cell if playing_cell else hovered_cell
        map_window  = draw_map_display(revealed_grid, active_cell, status_msg, status_color)
        
        cv2.imshow("Aquarium Map Display", map_window)

        # Draw Debug Camera Window
        cv2.putText(frame, status_msg, (30, 50), cv2.FONT_HERSHEY_SIMPLEX, 0.8, status_color, 2)
        cv2.imshow("Camera View (Debug)", frame)

        if cv2.waitKey(1) & 0xFF == 27:
            break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()