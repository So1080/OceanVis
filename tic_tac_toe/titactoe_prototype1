COLOR_HSV_RANGES = {
    "Rippled sand": (np.array([5, 125, 167]), np.array([22, 216, 252])),
    "Dense live bottom": (np.array([69, 4, 108]), np.array([89, 96, 198])),
    "Flat sand": (np.array([10, 90, 204]), np.array([27, 176, 255])),
    "Sparse live bottom": (np.array([81, 18, 182]), np.array([100, 107, 255]))
    # "Sparse live bottom": (np.array([80, 50, 100]), np.array([100, 255, 255])),
    # "Rippled sand":       (np.array([10, 80, 50]),  np.array([25, 255, 180])),
    # "Flat sand":          (np.array([15, 30, 120]), np.array([35, 150, 245])),
    # "Dense live bottom":  (np.array([85, 50, 40]),  np.array([105, 255, 130]))
}

GRID_ROWS = 2
GRID_COLS = 2
GRID_OFFSET_X = 0.1
GRID_OFFSET_Y = 0.1

TARGET_GRID_HABITATS = [
    ["Flat sand",       "Dense live bottom"],
    ["Rippled sand", "Sparse live bottom"]
]

DWELL_TIME             = 0.25   # hold this long to trigger audio
LIFT_CONFIRM_TIME      = 0.20   # absent this long to confirm lift
DEBOUNCE_DELAY         = 1.0    # wait this long after lift before evaluating
HAND_CONFIDENCE_THRESHOLD = 0.80

# -------------------------------------------------------------------
# AUDIO
# -------------------------------------------------------------------
pygame.mixer.pre_init(44100, -16, 2, 512)
pygame.init()
pygame.mixer.init()
pygame.mixer.set_num_channels(16)

HABITAT_CHANNEL = pygame.mixer.Channel(0)
EVAL_CHANNEL    = pygame.mixer.Channel(1)

HABITAT_SOUND_PATHS = {
    "Sparse live bottom": "Sounds_VF/BASIC_v3/BASIC-BASIC-sparse-live-8bars.wav",
    "Rippled sand":       "Sounds_VF/BASIC_v3/BASIC-BASIC-rippled-sand-8bars-v3.wav",
    "Flat sand":          "Sounds_VF/BASIC_v3/BASIC-BASIC-flat-sand-8bars-v3.wav",
    "Dense live bottom":  "Sounds_VF/BASIC_v3/BASIC-BASIC-dense-live-8bars-v3.wav",
    "correct":            "sounds/right_2.mp3",
    "wrong":              "sounds/wrong.mp3"
}

LOADED_SOUNDS = {}
print("\n--- AUDIO INITIALIZATION CHECK ---")
for key, path in HABITAT_SOUND_PATHS.items():
    if os.path.exists(path):
        try:
            LOADED_SOUNDS[key] = pygame.mixer.Sound(path)
            print(f"  [OK]      {key}")
        except Exception as e:
            print(f"  [ERROR]   {key}: {e}")
    else:
        print(f"  [MISSING] {key}: {os.path.abspath(path)}")
print("----------------------------------\n")


# -------------------------------------------------------------------
# HELPERS
# -------------------------------------------------------------------
def detect_cube_color(crop_bgr):
    if crop_bgr is None or crop_bgr.size == 0:
        return "Unknown"
    hsv        = cv2.cvtColor(crop_bgr, cv2.COLOR_BGR2HSV)
    max_pixels = 0
    detected   = "Unknown"
    for name, (lower, upper) in COLOR_HSV_RANGES.items():
        mask  = cv2.inRange(hsv, lower, upper)
        count = cv2.countNonZero(mask)
        if count > max_pixels and count > (crop_bgr.shape[0] * crop_bgr.shape[1] * 0.15):
            max_pixels = count
            detected   = name
    return detected


def get_camera_stream():
    for idx in [1, 0, 2]:
        cap = cv2.VideoCapture(idx)
        if cap.isOpened():
            ret, frame = cap.read()
            if ret and frame is not None:
                print(f"Connected to camera index {idx}")
                return cap
            cap.release()
    return None


def get_finger_tips(results, frame_w, frame_h):
    """Return index-finger-tip coords for every hand above confidence threshold."""
    tips = []
    if results.multi_hand_landmarks and results.multi_handedness:
        for lms, handedness in zip(results.multi_hand_landmarks,
                                   results.multi_handedness):
            if handedness.classification[0].score < HAND_CONFIDENCE_THRESHOLD:
                continue
            tip    = lms.landmark[mp.solutions.hands.HandLandmark.INDEX_FINGER_TIP]
            fx, fy = int(tip.x * frame_w), int(tip.y * frame_h)
            if 0 <= fx < frame_w and 0 <= fy < frame_h:
                tips.append((fx, fy))
    return tips


# -------------------------------------------------------------------
# MAIN
# -------------------------------------------------------------------
def main():
    cap = get_camera_stream()
    if cap is None:
        print("Error: could not open camera.")
        return

    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  1280)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)

    aruco_dict   = aruco.getPredefinedDictionary(aruco.DICT_4X4_100)
    aruco_params = aruco.DetectorParameters()

    mp_hands_mod = mp.solutions.hands
    hands        = mp_hands_mod.Hands(
        max_num_hands=2,
        min_detection_confidence=0.7,
        min_tracking_confidence=0.7
    )
    mp_draw = mp.solutions.drawing_utils

    # ---- interaction state (mirrors the working lift_test.py pattern) ----
    # Phase 1 — dwell
    hovered_cell      = None      # cell finger is currently over
    hover_start       = None      # when it entered that cell

    # Phase 2 — playing
    playing_cell      = None      # cell whose audio is looping
    saved_cell        = None      # cell cached for evaluation
    saved_crop        = None      # crop cached for evaluation

    # Phase 3 — lift detection (identical logic to lift_test.py)
    finger_in_cell    = False     # is finger currently inside playing_cell?
    absent_since      = None      # when finger first left playing_cell

    # Phase 4 — evaluation
    eval_pending      = False
    eval_trigger_time = None

    # Phase 5 — lockout while eval sound plays
    locked            = False

    status_msg   = "Touch and hold a cube to hear its habitat."
    status_color = (255, 255, 255)

    while cap.isOpened():
        ret, frame = cap.read()
        if not ret or frame is None:
            time.sleep(0.1)
            continue

        now     = time.time()
        h, w, _ = frame.shape

        # ---- ArUco ----
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        corners, ids, _ = aruco.detectMarkers(gray, aruco_dict, parameters=aruco_params)

        pt1, pt2 = None, None
        if ids is not None:
            aruco.drawDetectedMarkers(frame, corners, ids)
            for i, mid in enumerate(ids.flatten()):
                c = corners[i][0]
                if mid == 45:
                    pt1 = (int(c[:, 0].mean()), int(c[:, 1].mean()))
                elif mid == 57:
                    pt2 = (int(c[:, 0].mean()), int(c[:, 1].mean()))

        # ---- Hand tracking ----
        results = hands.process(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
        tips    = get_finger_tips(results, w, h)

        if results.multi_hand_landmarks and results.multi_handedness:
            for lms, handedness in zip(results.multi_hand_landmarks,
                                       results.multi_handedness):
                if handedness.classification[0].score >= HAND_CONFIDENCE_THRESHOLD:
                    mp_draw.draw_landmarks(frame, lms, mp_hands_mod.HAND_CONNECTIONS)

        for fx, fy in tips:
            cv2.circle(frame, (fx, fy), 8, (255, 0, 255), -1)

        # ---- Grid ----
        if pt1 and pt2:
            mx1, mx2 = min(pt1[0], pt2[0]), max(pt1[0], pt2[0])
            my1, my2 = min(pt1[1], pt2[1]), max(pt1[1], pt2[1])
            sx, sy   = mx2 - mx1, my2 - my1

            gx1 = int(mx1 + sx * GRID_OFFSET_X)
            gy1 = int(my1 + sy * GRID_OFFSET_Y)
            gx2 = int(mx2 - sx * GRID_OFFSET_X)
            gy2 = int(my2 - sy * GRID_OFFSET_Y)

            cv2.rectangle(frame, (gx1, gy1), (gx2, gy2), (255, 0, 0), 2)

            cw = (gx2 - gx1) / GRID_COLS
            ch = (gy2 - gy1) / GRID_ROWS

            # Find which cell (if any) the finger is in right now
            current_cell  = None
            current_crop  = None
            current_fpos  = None

            for r in range(GRID_ROWS):
                for c in range(GRID_COLS):
                    cx1 = int(gx1 + c * cw);       cy1 = int(gy1 + r * ch)
                    cx2 = int(gx1 + (c+1) * cw);   cy2 = int(gy1 + (r+1) * ch)

                    ix1 = int(cx1 + (cx2-cx1)*0.2); iy1 = int(cy1 + (cy2-cy1)*0.2)
                    ix2 = int(cx1 + (cx2-cx1)*0.8); iy2 = int(cy1 + (cy2-cy1)*0.8)

                    cv2.rectangle(frame, (cx1, cy1), (cx2, cy2), (255, 255, 0), 1)

                    for fx, fy in tips:
                        if cx1 <= fx <= cx2 and cy1 <= fy <= cy2:
                            current_cell = (r, c)
                            current_crop = frame[iy1:iy2, ix1:ix2].copy()
                            current_fpos = (fx, fy)
                            cv2.rectangle(frame, (cx1, cy1), (cx2, cy2), (0, 255, 255), 2)

            # ==============================================================
            # STATE MACHINE
            # ==============================================================

            # --- PHASE 5: locked while eval sound plays ---
            if locked:
                if not EVAL_CHANNEL.get_busy():
                    locked = False
                # nothing else runs while locked

            # --- PHASE 4: evaluation (runs even while locked, just checks timer) ---
            elif eval_pending:
                if now - eval_trigger_time >= DEBOUNCE_DELAY:
                    eval_pending = False
                    locked       = True

                    r_e, c_e       = saved_cell
                    target         = TARGET_GRID_HABITATS[r_e][c_e]
                    detected       = detect_cube_color(saved_crop)

                    print(f"[EVAL] cell ({r_e},{c_e})  target={target}  detected={detected}")

                    if detected == target:
                        status_msg   = f"Cube ({r_e+1},{c_e+1}) CORRECT: {target}"
                        status_color = (0, 255, 0)
                        if "correct" in LOADED_SOUNDS:
                            EVAL_CHANNEL.play(LOADED_SOUNDS["correct"])
                    else:
                        status_msg   = f"Cube ({r_e+1},{c_e+1}) INCORRECT: got {detected}, expected {target}"
                        status_color = (0, 0, 255)
                        if "wrong" in LOADED_SOUNDS:
                            EVAL_CHANNEL.play(LOADED_SOUNDS["wrong"])

            # --- PHASE 3: lift detection — runs only while audio is playing ---
            elif playing_cell is not None:
                # Is finger still inside the playing cell?
                now_in_cell = (current_cell == playing_cell)

                if now_in_cell:
                    # Finger returned — reset absence timer (same as lift_test.py)
                    finger_in_cell = True
                    absent_since   = None
                else:
                    if finger_in_cell:
                        # Finger just left — start absence timer
                        if absent_since is None:
                            absent_since = now
                    finger_in_cell = False

                    # Lift confirmed after LIFT_CONFIRM_TIME of continuous absence
                    if absent_since is not None and (now - absent_since) >= LIFT_CONFIRM_TIME:
                        print(f"[LIFT CONFIRMED] cell {playing_cell}")
                        HABITAT_CHANNEL.stop()

                        saved_cell        = playing_cell
                        saved_crop        = saved_crop   # already saved at dwell-trigger time
                        playing_cell      = None
                        finger_in_cell    = False
                        absent_since      = None
                        hovered_cell      = None
                        hover_start       = None

                        eval_pending      = True
                        eval_trigger_time = now

                        status_msg   = f"Evaluating Cube ({saved_cell[0]+1},{saved_cell[1]+1})..."
                        status_color = (200, 200, 200)

            # --- PHASE 1 & 2: dwell → play ---
            else:
                # Reset dwell if finger moved to a different cell
                if current_cell != hovered_cell:
                    hovered_cell = current_cell
                    hover_start  = now if current_cell is not None else None

                if hovered_cell is not None and hover_start is not None:
                    dwell = now - hover_start

                    # Progress ring
                    if current_fpos:
                        progress = min(1.0, dwell / DWELL_TIME)
                        cv2.circle(frame, current_fpos, int(8 + progress * 12),
                                   (0, 255, 255), 2)

                    # Dwell complete → start playing
                    if dwell >= DWELL_TIME:
                        playing_cell   = hovered_cell
                        saved_cell     = hovered_cell
                        saved_crop     = current_crop.copy() if current_crop is not None else None
                        finger_in_cell = True
                        absent_since   = None

                        r_h, c_h = playing_cell
                        habitat  = TARGET_GRID_HABITATS[r_h][c_h]
                        if habitat in LOADED_SOUNDS:
                            HABITAT_CHANNEL.play(LOADED_SOUNDS[habitat], loops=-1)

                        print(f"[PLAYING] cell ({r_h},{c_h}): {habitat}")
                        status_msg   = f"Listening to Cube ({r_h+1},{c_h+1}): {habitat}"
                        status_color = (0, 255, 255)

                        # Reset dwell so it doesn't re-trigger
                        hovered_cell = None
                        hover_start  = None

        else:
            cv2.putText(frame, "Waiting for ArUco markers 45 and 57...",
                        (30, 90), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 165, 255), 2)

        cv2.putText(frame, status_msg, (30, 50),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, status_color, 2)
        cv2.imshow("Aquarium Exhibit", frame)

        if cv2.waitKey(1) & 0xFF == 27:
            break

    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()

