def run_pause_menu():
    screen = pygame.display.set_mode((800, 500))
    pygame.display.set_caption("PAUSE")
    font = pygame.font.SysFont("Arial", 32)

    small_font = pygame.font.SysFont("Arial", 24)
    running = True
    while running:
        screen.fill((30, 30, 30))        
        title = font.render(f"Thank you for selecting the sounds!", True, (255, 255, 255))
        screen.blit(title, (50, 100))
        screen.blit(small_font.render("Please let the researcher know you are done with the first part", True, (255, 255, 255)), (50, 200))
        screen.blit(small_font.render("Researcher: Press [Q]", True, (255, 255, 255)), (300, 400))
        pygame.display.flip()

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                    pygame.quit(); exit()
            if event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_q:
                        running = False
    pygame.display.quit()


