def run_selection_menu():
    screen = pygame.display.set_mode((800, 500))
    pygame.display.set_caption("Habitat Sound Selection")
    font = pygame.font.SysFont("Arial", 32)
    small_font = pygame.font.SysFont("Arial", 24)
    italic_font = pygame.font.SysFont("Arial", 24, italic=True)
    
    current_idx = 0
    running = True

    last_hab_idx = -1
    is_description_playing = False
    
    while running:

        hab_name = HABITATS_ORDER[current_idx]

        # 1. AUTO-PLAY DESCRIPTION (Speech)
        if current_idx != last_hab_idx:
            pygame.mixer.stop()
            # Plays the 3rd index (the speech file) from your SOUND_OPTIONS
            description_sound = pygame.mixer.Sound(DESCRIPTIONS[hab_name])
            description_sound.play()
            is_description_playing = True
            last_hab_idx = current_idx

        if not pygame.mixer.get_busy():
            pygame.mixer.Sound(SOUND_OPTIONS[hab_name][0]).play()
            is_description_playing = False

        screen.fill((30, 30, 30))

        # 2. DRAW COLOR SQUARE
        # Draws a 100x100 square representing the habitat color
        rect_color = UI_COLORS.get(hab_name, (255, 255, 255))
        pygame.draw.rect(screen, rect_color, (600, 200, 100, 100))
        pygame.draw.rect(screen, (255, 255, 255), (600, 200, 100, 100), 2) # Border
        
        title = font.render(f"Select Sound for: {hab_name.upper()}", True, (255, 255, 255))
        screen.blit(title, (50, 50))

        if is_description_playing:
            status_txt = "Listening to description... Press [R] to skip"
            status_color = (255, 165, 0)
        else:
            status_txt = "Press [1, 2, 3] to Listen | [ENTER] to Confirm"
            status_color = (0, 200, 255)
        
        for i in range(3):
            text_color = (100, 100, 100) if is_description_playing else (150, 150, 150)
            text_color = (243, 164, 16) if not is_description_playing and selected_indices[hab_name] == i else (150, 150, 150)
            txt = f"Option {i+1}" + ("  <-- Playing" if not is_description_playing and selected_indices[hab_name] == i else "")
            txt_font = italic_font if not is_description_playing and selected_indices[hab_name] == i else small_font
            screen.blit(txt_font.render(txt, True, text_color), (100, 150 + (i * 60)))
            
        screen.blit(small_font.render(status_txt, True, status_color), (50, 400))
        pygame.display.flip()
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit(); exit()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_r:
                    pygame.mixer.stop()
                    is_description_playing = False
                    pygame.mixer.Sound(SOUND_OPTIONS[hab_name][0]).play()
                if not is_description_playing:
                    if event.key in [pygame.K_1, pygame.K_2, pygame.K_3]:
                        val = int(event.unicode) - 1
                        selected_indices[hab_name] = val
                        pygame.mixer.stop()
                        pygame.mixer.Sound(SOUND_OPTIONS[hab_name][val]).play()
                    if event.key == pygame.K_RETURN:
                        pygame.mixer.stop()
                        if current_idx < len(HABITATS_ORDER) - 1: 
                            current_idx += 1
                        else: running = False

    # Link chosen sounds to mask keys
    for mask_key, hab_name in MASK_TO_HABITAT.items():
        FINAL_SOUNDS[mask_key] = pygame.mixer.Sound(SOUND_OPTIONS[hab_name][selected_indices[hab_name]])
    
    FINAL_SOUNDS["correct"] = pygame.mixer.Sound("sounds/right_2.mp3")
    FINAL_SOUNDS["wrong"] = pygame.mixer.Sound("sounds/wrong.mp3")
    pygame.display.quit()

